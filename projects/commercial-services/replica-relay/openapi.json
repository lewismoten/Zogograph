{
  "openapi": "3.0.3",
  "info": {"title": "HostScope replica relay", "version": "v1", "description": "Optional ciphertext-only storage. It has no key custody or unwrap API."},
  "paths": {
    "/artifacts": {"get": {"summary": "List this tenant's ciphertext metadata", "security": [{"management": []}], "responses": {"200": {"description": "Metadata only"}}}},
    "/artifacts/{artifactId}": {"put": {"summary": "Store verified ciphertext", "security": [{"enrolledClient": []}], "parameters": [{"$ref": "#/components/parameters/ArtifactId"}, {"$ref": "#/components/parameters/Timestamp"}, {"$ref": "#/components/parameters/Nonce"}, {"$ref": "#/components/parameters/Signature"}, {"name": "X-HostScope-Ciphertext-SHA256", "in": "header", "required": true, "schema": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}], "requestBody": {"required": true, "content": {"application/octet-stream": {"schema": {"type": "string", "format": "binary"}}}}, "responses": {"201": {"description": "Ciphertext hash verified and stored"}}}, "get": {"summary": "Fetch verified ciphertext", "security": [{"enrolledClient": []}], "parameters": [{"$ref": "#/components/parameters/ArtifactId"}, {"$ref": "#/components/parameters/Timestamp"}, {"$ref": "#/components/parameters/Nonce"}, {"$ref": "#/components/parameters/Signature"}], "responses": {"200": {"description": "Ciphertext only"}}}, "delete": {"summary": "Delete relay ciphertext after recovery review", "security": [{"management": []}], "parameters": [{"$ref": "#/components/parameters/ArtifactId"}], "responses": {"200": {"description": "Deleted"}}}}
  },
  "components": {"parameters": {"ArtifactId": {"name": "artifactId", "in": "path", "required": true, "schema": {"type": "string", "pattern": "^[A-Za-z0-9._:-]{1,200}$"}}, "Timestamp": {"name": "X-HostScope-Timestamp", "in": "header", "required": true, "schema": {"type": "string"}}, "Nonce": {"name": "X-HostScope-Nonce", "in": "header", "required": true, "schema": {"type": "string"}}, "Signature": {"name": "X-HostScope-Signature", "in": "header", "required": true, "schema": {"type": "string"}}}, "securitySchemes": {"management": {"type": "http", "scheme": "bearer"}, "enrolledClient": {"type": "http", "scheme": "bearer", "description": "Also signs method, path, timestamp, nonce, and ciphertext hash."}}}
}
