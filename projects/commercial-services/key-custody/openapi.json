{
  "openapi": "3.1.0",
  "info": {
    "title": "HostScope Key Custody API",
    "version": "1.0.0-draft",
    "description": "Optional remote custody for wrapped encryption-key envelopes. Management endpoints never return key material. Enrolled-client unwrap is separately authenticated and returns key material only for immediate in-memory use."
  },
  "servers": [{"url": "{serviceBase}/v1", "variables": {"serviceBase": {"default": "https://configured.example/services/key-custody"}}}],
  "paths": {
    "/keys": {
      "get": {"summary": "List tenant key records", "responses": {"200": {"description": "Key metadata only"}}},
      "post": {"summary": "Create a tenant custody key record", "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/KeyCreate"}}}}, "responses": {"201": {"description": "Created"}}}
    },
    "/keys/{keyId}": {
      "patch": {"summary": "Update policy, disable, rotate, or retire a key", "parameters": [{"$ref": "#/components/parameters/KeyId"}], "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/KeyAction"}}}}, "responses": {"200": {"description": "Updated"}}}
    },
    "/keys/{keyId}/envelopes": {
      "post": {"summary": "Store a wrapped DEK envelope", "security": [{"enrolledClient": []}], "parameters": [{"$ref": "#/components/parameters/KeyId"}, {"$ref": "#/components/parameters/ClientTimestamp"}, {"$ref": "#/components/parameters/ClientNonce"}, {"$ref": "#/components/parameters/ClientSignature"}], "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/EnvelopeStore"}}}}, "responses": {"201": {"description": "Envelope recorded"}}},
      "get": {"summary": "List envelope metadata", "parameters": [{"$ref": "#/components/parameters/KeyId"}], "responses": {"200": {"description": "Metadata only"}}}
    },
    "/keys/{keyId}/envelopes/{artifactId}": {
      "delete": {"summary": "Delete one named envelope after verifying another recovery path", "security": [{"accountSession": []}], "parameters": [{"$ref": "#/components/parameters/KeyId"}, {"name": "artifactId", "in": "path", "required": true, "schema": {"type": "string", "maxLength": 200}}], "responses": {"200": {"description": "Envelope deleted; the custody key and other envelopes remain."}, "403": {"description": "Envelope does not belong to the tenant or is unavailable."}}}
    },
    "/keys/{keyId}/unwrap-authorizations": {
      "post": {"summary": "Request a custody key for one registered envelope", "security": [{"enrolledClient": []}], "parameters": [{"$ref": "#/components/parameters/KeyId"}, {"$ref": "#/components/parameters/ClientTimestamp"}, {"$ref": "#/components/parameters/ClientNonce"}, {"$ref": "#/components/parameters/ClientSignature"}], "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/UnwrapRequest"}}}}, "responses": {"201": {"description": "Key material for immediate in-memory use, plus a cache recommendation"}, "403": {"description": "Policy, envelope, subscription, or enrollment refusal"}}}
    },
    "/client-credentials/rotate": {
      "post": {"summary": "Replace all enrolled-client credentials", "security": [{"accountSession": []}], "responses": {"201": {"description": "One-time replacement bearer token and Ed25519 private signing key; all prior enrolled-client credentials are revoked."}}}
    },
    "/client-credentials": {
      "get": {"summary": "List enrolled-client credential metadata", "security": [{"accountSession": []}], "responses": {"200": {"description": "Credential identifiers, states, and creation times only; no tokens or private keys."}}},
      "post": {"summary": "Create one enrolled-client credential for one deployment", "security": [{"accountSession": []}], "responses": {"201": {"description": "One-time credential id, bearer token, and Ed25519 private signing key."}}}
    },
    "/client-credentials/{credentialId}": {
      "delete": {"summary": "Revoke one enrolled-client credential", "security": [{"accountSession": []}], "parameters": [{"name": "credentialId", "in": "path", "required": true, "schema": {"type": "string", "pattern": "^tok_[a-f0-9]{20}$"}}], "responses": {"200": {"description": "Credential revoked; other enrolled clients remain unchanged."}}}
    },
    "/management-credentials/rotate": {
      "post": {"summary": "Replace all customer management credentials", "security": [{"accountSession": []}], "responses": {"201": {"description": "One-time replacement management bearer token; all prior management credentials are revoked."}}}
    },
    "/audit": {
      "get": {"summary": "Read bounded, tenant-scoped custody audit metadata", "security": [{"accountSession": []}], "parameters": [{"name": "limit", "in": "query", "schema": {"type": "integer", "minimum": 1, "maximum": 100, "default": 50}}], "responses": {"200": {"description": "Recent operational events without keys, envelopes, tokens, or private signing material."}}}
    },
    "/subscription": {
      "get": {"summary": "Read plan, quota, renewal, custody availability, and the tenant's recent change requests", "responses": {"200": {"description": "Subscription state and request history"}}},
      "patch": {"summary": "Request a plan change or cancellation", "responses": {"202": {"description": "Auditable pending billing request"}}}
    },
    "/subscription/requests/{requestId}": {
      "delete": {"summary": "Withdraw the tenant's pending subscription request", "security": [{"accountSession": []}], "parameters": [{"name": "requestId", "in": "path", "required": true, "schema": {"type": "string", "pattern": "^subreq_[a-f0-9]{24}$"}}], "responses": {"200": {"description": "Request withdrawn"}, "403": {"description": "Request was not pending or does not belong to the tenant"}}}
    },
    "/billing/checkout": {
      "post": {"summary": "Create a hosted checkout or invoice session", "responses": {"201": {"description": "Opaque billing-session URL/reference"}}}
    },
    "/billing/portal": {
      "post": {"summary": "Create a hosted billing-management session", "responses": {"201": {"description": "Opaque billing-session URL/reference"}}}
    },
    "/internal/subscriptions/{tenantId}": {
      "patch": {"summary": "Apply a commercial billing entitlement", "description": "Internal control-plane endpoint. Its separate billing token can change subscription state only; it cannot manage or unwrap keys.", "security": [{"billingService": []}], "parameters": [{"name": "tenantId", "in": "path", "required": true, "schema": {"type": "string", "pattern": "^ten_[a-f0-9]{24}$"}}], "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/SubscriptionApply"}}}}, "responses": {"200": {"description": "Entitlement applied and pending requests resolved"}, "403": {"description": "Billing control token is invalid"}, "503": {"description": "Billing control integration is disabled"}}}
    }
  },
  "components": {
    "securitySchemes": {
      "accountSession": {"type": "http", "scheme": "bearer", "description": "Account management token; never valid for unwrap requests."},
      "enrolledClient": {"type": "http", "scheme": "bearer", "description": "Enrolled-client bearer credential plus required Ed25519 request-signature headers. mTLS can be added by the deployment proxy."},
      "billingService": {"type": "http", "scheme": "bearer", "description": "Private commercial billing-control token. It can apply entitlements only and is never accepted by custody key endpoints."}
    },
    "parameters": {
      "KeyId": {"name": "keyId", "in": "path", "required": true, "schema": {"type": "string", "pattern": "^[a-zA-Z0-9_-]{12,120}$"}},
      "ClientTimestamp": {"name": "X-HostScope-Timestamp", "in": "header", "required": true, "schema": {"type": "string", "pattern": "^[0-9]{10,}$"}},
      "ClientNonce": {"name": "X-HostScope-Nonce", "in": "header", "required": true, "schema": {"type": "string", "pattern": "^[A-Za-z0-9_-]{16,200}$"}},
      "ClientSignature": {"name": "X-HostScope-Signature", "in": "header", "required": true, "description": "Base64 Ed25519 signature over METHOD, path, timestamp, nonce, and Base64 SHA-256 request-body hash separated by newlines.", "schema": {"type": "string"}}
    },
    "schemas": {
      "KeyCreate": {"type": "object", "additionalProperties": false, "required": ["name", "authorization_ttl_seconds"], "properties": {"name": {"type": "string", "minLength": 1, "maxLength": 120}, "authorization_ttl_seconds": {"type": "integer", "minimum": 60, "maximum": 900}}},
      "KeyAction": {"type": "object", "additionalProperties": false, "required": ["action"], "properties": {"action": {"enum": ["disable", "rotate", "retire", "update_policy"]}, "name": {"type": "string", "minLength": 1, "maxLength": 120}, "authorization_ttl_seconds": {"type": "integer", "minimum": 60, "maximum": 900}}, "allOf": [{"if": {"properties": {"action": {"const": "update_policy"}}}, "then": {"required": ["authorization_ttl_seconds"]}}]},
      "EnvelopeStore": {"type": "object", "additionalProperties": false, "required": ["artifact_id", "envelope_base64"], "properties": {"artifact_id": {"type": "string", "minLength": 1, "maxLength": 200}, "envelope_base64": {"type": "string", "minLength": 1, "maxLength": 1398104}}},
      "SubscriptionApply": {"type": "object", "additionalProperties": false, "required": ["plan", "state", "key_quota"], "properties": {"plan": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,62}$"}, "state": {"enum": ["active", "past_due", "cancelled"]}, "key_quota": {"type": "integer", "minimum": 0, "maximum": 10000}, "renews_at": {"type": ["integer", "null"], "minimum": 0, "maximum": 4102444800}}},
      "UnwrapRequest": {"type": "object", "additionalProperties": false, "required": ["artifact_id", "nonce"], "properties": {"artifact_id": {"type": "string", "minLength": 1, "maxLength": 200}, "nonce": {"type": "string", "minLength": 1, "maxLength": 200}, "requested_ttl_seconds": {"type": "integer", "minimum": 0, "maximum": 900, "default": 0}}}
    }
  }
}
