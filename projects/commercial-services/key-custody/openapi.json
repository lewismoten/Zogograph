{
  "openapi": "3.1.0",
  "info": {
    "title": "HostScope Key Custody API",
    "version": "1.0.0-draft",
    "description": "Optional remote custody for wrapped encryption-key envelopes. Management endpoints never return key material. Enrolled-client unwrap is separately authenticated and returns key material only for immediate in-memory use."
  },
  "servers": [{"url": "{serviceBase}/v1", "variables": {"serviceBase": {"default": "https://configured.example/services/key-custody"}}}],
  "paths": {
    "/keys": {
      "get": {"summary": "List tenant key records", "responses": {"200": {"description": "Key metadata only"}}},
      "post": {"summary": "Create a tenant custody key record", "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/KeyCreate"}}}}, "responses": {"201": {"description": "Created"}}}
    },
    "/keys/{keyId}": {
      "get": {"summary": "Read key policy and lifecycle state", "parameters": [{"$ref": "#/components/parameters/KeyId"}], "responses": {"200": {"description": "Metadata only"}}},
      "patch": {"summary": "Rotate, disable, or change key policy", "parameters": [{"$ref": "#/components/parameters/KeyId"}], "responses": {"200": {"description": "Updated"}}}
    },
    "/keys/{keyId}/envelopes": {
      "post": {"summary": "Store a wrapped DEK envelope", "security": [{"enrolledClient": []}], "parameters": [{"$ref": "#/components/parameters/KeyId"}, {"$ref": "#/components/parameters/ClientTimestamp"}, {"$ref": "#/components/parameters/ClientNonce"}, {"$ref": "#/components/parameters/ClientSignature"}], "responses": {"201": {"description": "Envelope recorded"}}},
      "get": {"summary": "List envelope metadata", "parameters": [{"$ref": "#/components/parameters/KeyId"}], "responses": {"200": {"description": "Metadata only"}}}
    },
    "/keys/{keyId}/unwrap-authorizations": {
      "post": {"summary": "Request a custody key for one registered envelope", "security": [{"enrolledClient": []}], "parameters": [{"$ref": "#/components/parameters/KeyId"}, {"$ref": "#/components/parameters/ClientTimestamp"}, {"$ref": "#/components/parameters/ClientNonce"}, {"$ref": "#/components/parameters/ClientSignature"}], "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/UnwrapRequest"}}}}, "responses": {"201": {"description": "Key material for immediate in-memory use, plus a cache recommendation"}, "403": {"description": "Policy, envelope, subscription, or enrollment refusal"}}}
    },
    "/client-credentials/rotate": {
      "post": {"summary": "Replace all enrolled-client credentials", "security": [{"accountSession": []}], "responses": {"201": {"description": "One-time replacement bearer token and Ed25519 private signing key; all prior enrolled-client credentials are revoked."}}}
    },
    "/audit": {
      "get": {"summary": "Read bounded, tenant-scoped custody audit metadata", "security": [{"accountSession": []}], "parameters": [{"name": "limit", "in": "query", "schema": {"type": "integer", "minimum": 1, "maximum": 100, "default": 50}}], "responses": {"200": {"description": "Recent operational events without keys, envelopes, tokens, or private signing material."}}}
    },
    "/subscription": {
      "get": {"summary": "Read plan, quota, renewal, custody availability, and the tenant's recent change requests", "responses": {"200": {"description": "Subscription state and request history"}}},
      "patch": {"summary": "Request a plan change or cancellation", "responses": {"202": {"description": "Auditable pending billing request"}}}
    },
    "/subscription/requests/{requestId}": {
      "delete": {"summary": "Withdraw the tenant's pending subscription request", "security": [{"accountSession": []}], "parameters": [{"name": "requestId", "in": "path", "required": true, "schema": {"type": "string", "pattern": "^subreq_[a-f0-9]{24}$"}}], "responses": {"200": {"description": "Request withdrawn"}, "403": {"description": "Request was not pending or does not belong to the tenant"}}}
    },
    "/billing/checkout": {
      "post": {"summary": "Create a hosted checkout or invoice session", "responses": {"201": {"description": "Opaque billing-session URL/reference"}}}
    },
    "/billing/portal": {
      "post": {"summary": "Create a hosted billing-management session", "responses": {"201": {"description": "Opaque billing-session URL/reference"}}}
    }
  },
  "components": {
    "securitySchemes": {
      "accountSession": {"type": "http", "scheme": "bearer", "description": "Account management token; never valid for unwrap requests."},
      "enrolledClient": {"type": "http", "scheme": "bearer", "description": "Enrolled-client bearer credential plus required Ed25519 request-signature headers. mTLS can be added by the deployment proxy."}
    },
    "parameters": {
      "KeyId": {"name": "keyId", "in": "path", "required": true, "schema": {"type": "string", "pattern": "^[a-zA-Z0-9_-]{12,120}$"}},
      "ClientTimestamp": {"name": "X-HostScope-Timestamp", "in": "header", "required": true, "schema": {"type": "string", "pattern": "^[0-9]{10,}$"}},
      "ClientNonce": {"name": "X-HostScope-Nonce", "in": "header", "required": true, "schema": {"type": "string", "pattern": "^[A-Za-z0-9_-]{16,200}$"}},
      "ClientSignature": {"name": "X-HostScope-Signature", "in": "header", "required": true, "description": "Base64 Ed25519 signature over METHOD, path, timestamp, nonce, and Base64 SHA-256 request-body hash separated by newlines.", "schema": {"type": "string"}}
    },
    "schemas": {
      "KeyCreate": {"type": "object", "required": ["name", "algorithm", "authorization_ttl_seconds"], "properties": {"name": {"type": "string", "maxLength": 120}, "algorithm": {"const": "aes-256-gcm-envelope"}, "authorization_ttl_seconds": {"type": "integer", "minimum": 60, "maximum": 900}}},
      "UnwrapRequest": {"type": "object", "required": ["envelope_id", "artifact_id", "nonce", "requested_ttl_seconds"], "properties": {"envelope_id": {"type": "string"}, "artifact_id": {"type": "string", "maxLength": 200}, "nonce": {"type": "string", "maxLength": 200}, "requested_ttl_seconds": {"type": "integer", "minimum": 60, "maximum": 900}}}
    }
  }
}
