{
  "openapi": "3.0.3",
  "info": {"title": "Zogograph replica relay", "version": "v1", "description": "Optional ciphertext-only storage. It has no key custody or unwrap API."},
  "paths": {
    "/health": {"get": {"summary": "Read service liveness without tenant or credential data", "security": [], "responses": {"200": {"description": "Private SQLite service store opened successfully"}, "503": {"description": "Service configuration is unavailable"}}}},
    "/artifacts": {"get": {"summary": "List this tenant's ciphertext metadata", "security": [{"management": []}], "responses": {"200": {"description": "Metadata only"}}}},
    "/client/entitlement": {"get": {"summary": "Read enrolled-client ciphertext capacity", "description": "Signed enrolled-client view only; it cannot manage or retrieve artifacts.", "security": [{"enrolledClient": []}], "parameters": [{"$ref": "#/components/parameters/Timestamp"}, {"$ref": "#/components/parameters/Nonce"}, {"$ref": "#/components/parameters/Signature"}], "responses": {"200": {"description": "Artifact and ciphertext capacity usage with upload readiness."}}}},
    "/artifacts/{artifactId}": {"put": {"summary": "Store verified ciphertext", "security": [{"enrolledClient": []}], "parameters": [{"$ref": "#/components/parameters/ArtifactId"}, {"$ref": "#/components/parameters/Timestamp"}, {"$ref": "#/components/parameters/Nonce"}, {"$ref": "#/components/parameters/Signature"}, {"name": "X-HostScope-Ciphertext-SHA256", "in": "header", "required": true, "schema": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}], "requestBody": {"required": true, "content": {"application/octet-stream": {"schema": {"type": "string", "format": "binary"}}}}, "responses": {"201": {"description": "Ciphertext hash verified and stored"}}}, "get": {"summary": "Fetch verified ciphertext", "security": [{"enrolledClient": []}], "parameters": [{"$ref": "#/components/parameters/ArtifactId"}, {"$ref": "#/components/parameters/Timestamp"}, {"$ref": "#/components/parameters/Nonce"}, {"$ref": "#/components/parameters/Signature"}], "responses": {"200": {"description": "Ciphertext only"}}}, "delete": {"summary": "Delete relay ciphertext after recovery review", "security": [{"management": []}], "parameters": [{"$ref": "#/components/parameters/ArtifactId"}], "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/RecoveryDeleteConfirmation"}}}}, "responses": {"200": {"description": "Deleted"}}}}
  },
  "components": {"parameters": {"ArtifactId": {"name": "artifactId", "in": "path", "required": true, "schema": {"type": "string", "pattern": "^[A-Za-z0-9._:-]{1,200}$"}}, "Timestamp": {"name": "X-HostScope-Timestamp", "in": "header", "required": true, "schema": {"type": "string"}}, "Nonce": {"name": "X-HostScope-Nonce", "in": "header", "required": true, "schema": {"type": "string"}}, "Signature": {"name": "X-HostScope-Signature", "in": "header", "required": true, "schema": {"type": "string"}}}, "schemas": {"RecoveryDeleteConfirmation": {"type": "object", "additionalProperties": false, "required": ["confirm_recovery"], "properties": {"confirm_recovery": {"const": true, "description": "Caller attests that another verified recovery copy exists."}}}}, "securitySchemes": {"management": {"type": "http", "scheme": "bearer"}, "enrolledClient": {"type": "http", "scheme": "bearer", "description": "Also signs method, path, timestamp, nonce, and ciphertext hash."}}}
}
